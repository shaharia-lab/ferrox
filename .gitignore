# Rust build output (Cargo.lock is intentionally committed — this is a binary crate)
/target/

# Local config overrides with real API keys.
# Patterns containing a slash are anchored to this directory, so an unanchored
# `config/local.yaml` would NOT match `ferrox/config/local.yaml` — the path the
# Makefile actually generates. Use `**/` so every config dir is covered.
**/config/local.yaml
**/config/local.*.yaml

# Environment files with secrets
.env
.env.local
.env.*.local

# Docker named volumes (created at runtime)
prometheus-data/
grafana-data/
lgtm-data/

# Node / UI
ferrox-cp/ui/node_modules/
# Compiled UI assets (placeholder index.html is committed; real dist is built in CI/Docker)
ferrox-cp/ui/dist/
!ferrox-cp/ui/dist/index.html

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp
*.swo
